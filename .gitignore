.idea
backend/node_modules
backend/.env

# Ignore Terraform state and provider binaries
.terraform/
.terraform.lock.hcl

# Terraform state files
*.tfstate
*.tfstate.*
crash.log

# Variable files that may contain secrets
*.tfvars
*.tfvars.json

# Sensitive SSH keys
*.pem
*.key
*.pub

# Custom keys
terra-key
terra-key.pub

# Backup files
*.backup
*.bak
